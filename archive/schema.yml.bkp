version: 2

models:
  - name: stg_employees.bkp
    description: >
      Staging model that cleans and standardizes raw employee data.
      This model performs data transformations such as converting employee names
      to uppercase, deriving salary categories, calculating annual salary,
      and preparing employee records for downstream business models.

    columns:
      - name: emp_id
        description: Unique identifier assigned to each employee. Used as the primary key across employee-related models.
        tests:
          - unique
          - not_null

      - name: employee_name
        description: Employee name converted to uppercase for consistency.
        tests:
          - not_null

      - name: department
        description: Department in which the employee currently works.

      - name: dept_id
        description: Department identifier used to link employees with the departments dimension.
        tests:
          - relationships:
              arguments:
                to: ref('departments')
                field: dept_id

      - name: salary
        description: Monthly salary of the employee in INR.
        tests:
          - not_null

      - name: salary_category
        description: Business-defined salary band derived from the monthly salary.
        tests:
          - accepted_values:
              arguments:
                values:
                  - Low
                  - Medium
                  - High
                  - Very High

      - name: city
        description: City where the employee is located.

      - name: annual_salary
        description: Annual salary calculated as monthly salary multiplied by 12.