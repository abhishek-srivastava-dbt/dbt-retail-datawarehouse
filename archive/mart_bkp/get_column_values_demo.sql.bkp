{% set department_list =
    dbt_utils.get_column_values(
        table=ref('stg_employees'),
        column='department'
    )
%}

SELECT

{% for department in department_list %}

SUM(
    CASE
        WHEN department = '{{ department }}'
        THEN 1
        ELSE 0
    END
) AS {{ department | replace(' ','_') }}

{% if not loop.last %},{% endif %}

{% endfor %}

FROM {{ ref('stg_employees') }}