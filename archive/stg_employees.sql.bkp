SELECT

    updated_at,

    emp_id,

    UPPER(emp_name) AS employee_name,

    department,

    dept_id,

    salary,

    CASE
        WHEN salary >= 200000 THEN 'Very High'
        WHEN salary >= 150000 THEN 'High'
        WHEN salary >= 100000 THEN 'Medium'
        ELSE 'Low'
    END AS salary_category,

    UPPER(city) AS city,

    salary * 12 AS annual_salary

FROM {{ source('raw', 'employees') }}